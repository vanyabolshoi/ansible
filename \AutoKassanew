---
- name: Update AutoKassa
  hosts: all
  gather_facts: no

  vars:
    msi_url: "http://10.9.0.10/soft/EncashSetup2.msi"
    msi_file: "C:\\Temp\\EncashSetup2.msi"

  tasks:

    - name: Create temp directory
      win_file:
        path: C:\Temp
        state: directory

    - name: Stop running Encash processes
      win_shell: |
        Get-Process | Where-Object {
          $_.ProcessName -match "Encash|AutoKassa|Kassa"
        } | Stop-Process -Force
      failed_when: false

    - name: Wait for processes to close
      win_wait_for:
        timeout: 5

    - name: Download MSI
      win_get_url:
        url: "{{ msi_url }}"
        dest: "{{ msi_file }}"
        force: yes

    - name: Install MSI silently
      win_package:
        path: "{{ msi_file }}"
        state: present
        arguments: "/qn /norestart"
      register: install_result

    - name: Reboot if required
      win_reboot:
        reboot_timeout: 1800
      when: install_result.reboot_required | default(false)

    - name: Show installation result
      debug:
        msg:
          - "Changed: {{ install_result.changed }}"
          - "Reboot required: {{ install_result.reboot_required | default(false) }}"
