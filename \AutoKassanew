---
- name: Update Encash
  hosts: all
  gather_facts: no

  vars:
    download_url: "ВСТАВЬ_СЮДА_ПОЛНУЮ_ССЫЛКУ_OneDrive"
    local_file: "C:\\Temp\\EncashSetup2.msi"

  tasks:

    - name: Create temp directory
      win_file:
        path: C:\Temp
        state: directory

    - name: Close Encash processes
      win_shell: |
        Get-Process | Where-Object {
          $_.ProcessName -match "Encash|AutoKassa|Kassa"
        } | Stop-Process -Force
      failed_when: false

    - name: Wait for processes to close
      pause:
        seconds: 5

    - name: Download installer
      win_get_url:
        url: "{{ download_url }}"
        dest: "{{ local_file }}"
        force: yes
        timeout: 600

    - name: Verify downloaded file size
      win_stat:
        path: "{{ local_file }}"
      register: msi_file

    - name: Stop if file is too small
      fail:
        msg: "Downloaded file is invalid. Size: {{ msi_file.stat.size }} bytes"
      when: msi_file.stat.size | int < 1000000

    - name: Install MSI
      win_package:
        path: "{{ local_file }}"
        state: present
        arguments: "/qn /norestart"
      register: install_result

    - name: Reboot if required
      win_reboot:
        reboot_timeout: 1800
      when: install_result.reboot_required | default(false)

    - name: Show result
      debug:
        msg:
          - "Installation completed"
          - "Changed: {{ install_result.changed }}"
          - "Reboot required: {{ install_result.reboot_required | default(false) }}"
