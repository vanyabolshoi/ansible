---

* name: Install AgentETP x64 1.0.34.150
  hosts: windows
  gather_facts: no

  vars:
  target_version: "1.0.34.150"
  installer_url: "https://github.com/vanyabolshoi/ansible/raw/refs/heads/main/SetupAgentETP_x64_1.0.34.150.exe"
  installer_path: 'C:\Windows\Temp\SetupAgentETP_x64_1.0.34.150.exe'
  install_log: 'C:\Windows\Temp\AgentETP_install.log'
  service_name: '1C_AgentETP_x86-64'

  tasks:

  * name: Show target
    ansible.builtin.debug:
    msg:
    - "Installing AgentETP {{ target_version }}"
    - "Installer: {{ installer_url }}"
    - "Target: {{ inventory_hostname }}"

  * name: Get current AgentETP service
    ansible.windows.win_shell: |
    $service = Get-CimInstance Win32_Service -Filter "Name='{{ service_name }}'" -ErrorAction SilentlyContinue

    if (-not $service) {
    Write-Output "SERVICE_NOT_FOUND"
    exit 0
    }

    Write-Output "SERVICE_NAME=$($service.Name)"
    Write-Output "SERVICE_STATE=$($service.State)"
    Write-Output "SERVICE_STARTMODE=$($service.StartMode)"
    Write-Output "SERVICE_PATH=$($service.PathName)"

    $path = $service.PathName
    $exe = $null

    if ($path -match '"([^"]+AgentETP.exe)"') {
    $exe = $matches[1]
    }
    elseif ($path -match '([A-Za-z]:\.*AgentETP.exe)') {
    $exe = $matches[1]
    }

    if ($exe -and (Test-Path $exe)) {
    $item = Get-Item $exe

    ```
      Write-Output "EXE=$exe"
      Write-Output "PRODUCT_VERSION=$($item.VersionInfo.ProductVersion)"
      Write-Output "FILE_VERSION=$($item.VersionInfo.FileVersion)"
    ```

    }
    else {
    Write-Output "AGENTETP_EXE_NOT_FOUND"
    }
    register: current_agent
    changed_when: false

  * name: Show current AgentETP
    ansible.builtin.debug:
    var: current_agent.stdout_lines

  * name: Download AgentETP installer
    ansible.windows.win_get_url:
    url: "{{ installer_url }}"
    dest: "{{ installer_path }}"
    force: yes
    register: download_result

  * name: Check downloaded installer
    ansible.windows.win_stat:
    path: "{{ installer_path }}"
    checksum_algorithm: sha256
    register: installer_file

  * name: Show installer information
    ansible.builtin.debug:
    msg:
    - "Exists: {{ installer_file.stat.exists }}"
    - "Size: {{ installer_file.stat.size | default(0) }} bytes"
    - "SHA256: {{ installer_file.stat.checksum | default('unknown') }}"

  * name: Verify installer
    ansible.builtin.assert:
    that:
    - installer_file.stat.exists
    - installer_file.stat.size | int > 100000
    fail_msg: "Installer was not downloaded correctly."
    success_msg: "Installer downloaded successfully."

  * name: Stop AgentETP service
    ansible.windows.win_service:
    name: "{{ service_name }}"
    state: stopped
    register: stop_service
    failed_when: false

  * name: Kill old AgentETP processes
    ansible.windows.win_shell: |
    Get-CimInstance Win32_Process -ErrorAction SilentlyContinue |
    Where-Object {
    $*.Name -match 'AgentETP|SetupAgentETP'
    } |
    ForEach-Object {
    Write-Output "Stopping PID=$($*.ProcessId) NAME=$($*.Name)"
    Stop-Process -Id $*.ProcessId -Force -ErrorAction SilentlyContinue
    }

    Start-Sleep -Seconds 3
    changed_when: false

  * name: Remove previous install log
    ansible.windows.win_file:
    path: "{{ install_log }}"
    state: absent

  * name: Run AgentETP installer diagnostic
    ansible.windows.win_shell: |
    $ErrorActionPreference = "Continue"

    $installer = "{{ installer_path }}"
    $log = "{{ install_log }}"
    $workDir = Split-Path $installer

    Write-Output "========================================"
    Write-Output "AGENTETP INSTALLATION"
    Write-Output "========================================"
    Write-Output "Installer: $installer"
    Write-Output "Working directory: $workDir"

    if (-not (Test-Path $installer)) {
    Write-Output "ERROR: INSTALLER_NOT_FOUND"
    exit 10
    }

    $file = Get-Item $installer

    Write-Output "File size: $($file.Length)"
    Write-Output "ProductVersion: $($file.VersionInfo.ProductVersion)"
    Write-Output "FileVersion: $($file.VersionInfo.FileVersion)"

    $startTime = Get-Date

    Write-Output "Starting installer..."

    $process = Start-Process `    -FilePath $installer`
    -ArgumentList "/S" `    -WorkingDirectory $workDir`
    -PassThru

    Write-Output "Installer PID: $($process.Id)"

    $timeout = 900
    $elapsed = 0

    while (-not $process.HasExited) {

    ```
      Start-Sleep -Seconds 10

      $elapsed += 10

      $process.Refresh()

      Write-Output "Installer running: $elapsed seconds"

      Get-CimInstance Win32_Process -ErrorAction SilentlyContinue |
        Where-Object {
          $_.ProcessId -eq $process.Id -or
          $_.ParentProcessId -eq $process.Id -or
          $_.Name -match 'SetupAgentETP|AgentETP|msiexec'
        } |
        Select-Object ProcessId, ParentProcessId, Name, CommandLine |
        Format-Table -AutoSize |
        Out-String |
        Write-Output

      if ($elapsed -ge $timeout) {

          Write-Output "INSTALLER TIMEOUT"

          Get-CimInstance Win32_Process -ErrorAction SilentlyContinue |
            Where-Object {
              $_.Name -match 'SetupAgentETP|AgentETP|msiexec'
            } |
            Select-Object ProcessId, ParentProcessId, Name, CommandLine |
            Format-List |
            Out-String |
            Write-Output

          Stop-Process -Id $process.Id -Force -ErrorAction SilentlyContinue

          exit 20
      }
    ```

    }

    $process.Refresh()

    $exitCode = $process.ExitCode
    $duration = (Get-Date) - $startTime

    Write-Output "========================================"
    Write-Output "INSTALLER FINISHED"
    Write-Output "========================================"
    Write-Output "ExitCode: $exitCode"
    Write-Output "Duration: $duration"
    Write-Output "========================================"

    Write-Output "AGENTETP PROCESSES"

    Get-CimInstance Win32_Process -ErrorAction SilentlyContinue |
    Where-Object {
    $_.Name -match 'AgentETP|SetupAgentETP|msiexec'
    } |
    Select-Object ProcessId, ParentProcessId, Name, CommandLine |
    Format-List |
    Out-String |
    Write-Output

    Write-Output "========================================"
    Write-Output "SERVICE STATE"
    Write-Output "========================================"

    $service = Get-CimInstance Win32_Service -Filter "Name='{{ service_name }}'" -ErrorAction SilentlyContinue

    if ($service) {
    $service |
    Select-Object Name, State, StartMode, PathName |
    Format-List |
    Out-String |
    Write-Output
    }
    else {
    Write-Output "SERVICE_NOT_FOUND"
    }

    Write-Output "========================================"
    Write-Output "AGENTETP DIRECTORY"
    Write-Output "========================================"

    if (Test-Path "C:\Program Files\1C\AgentETP") {

    ```
      Get-ChildItem `
        "C:\Program Files\1C\AgentETP" `
        -Recurse `
        -ErrorAction SilentlyContinue |
        Select-Object FullName, Length, LastWriteTime |
        Sort-Object LastWriteTime -Descending |
        Select-Object -First 100 |
        Format-Table -AutoSize |
        Out-String |
        Write-Output
    ```

    }
    else {
    Write-Output "AGENTETP_DIRECTORY_NOT_FOUND"
    }

    Write-Output "========================================"
    Write-Output "WINDOWS TEMP RECENT FILES"
    Write-Output "========================================"

    Get-ChildItem "C:\Windows\Temp" `    -File`
    -ErrorAction SilentlyContinue |
    Where-Object {
    $_.LastWriteTime -ge $startTime
    } |
    Sort-Object LastWriteTime -Descending |
    Select-Object -First 100 Name, Length, LastWriteTime, FullName |
    Format-Table -AutoSize |
    Out-String |
    Write-Output

    Write-Output "========================================"
    Write-Output "INSTALL LOG"
    Write-Output "========================================"

    if (Test-Path $log) {

    ```
      Write-Output "LOG FOUND"
      Write-Output "LOG SIZE: $((Get-Item $log).Length)"

      Get-Content $log -Tail 300 -ErrorAction SilentlyContinue
    ```

    }
    else {
    Write-Output "NO INSTALL LOG FOUND"
    }

    Write-Output "========================================"
    Write-Output "APPLICATION ERRORS/WARNINGS"
    Write-Output "========================================"

    Get-WinEvent `    -FilterHashtable @{
          LogName = "Application"
          StartTime = $startTime
        }`
    -ErrorAction SilentlyContinue |
    Where-Object {
    $_.LevelDisplayName -in @("Error","Warning")
    } |
    Select-Object -First 100 TimeCreated, ProviderName, Id, LevelDisplayName, Message |
    Format-List |
    Out-String |
    Write-Output

    Write-Output "========================================"
    Write-Output "MSI INSTALLER EVENTS"
    Write-Output "========================================"

    Get-WinEvent `    -FilterHashtable @{
          LogName = "Application"
          ProviderName = "MsiInstaller"
          StartTime = $startTime
        }`
    -ErrorAction SilentlyContinue |
    Select-Object -First 100 TimeCreated, Id, LevelDisplayName, Message |
    Format-List |
    Out-String |
    Write-Output

    Write-Output "========================================"
    Write-Output "INSTALLER EXIT CODE"
    Write-Output "========================================"

    Write-Output "EXIT_CODE=$exitCode"

    Write-Output "========================================"
    Write-Output "DIAGNOSTIC FINISHED"
    Write-Output "========================================"

    exit 0

    register: installer_result
    changed_when: true

  * name: Show installer output
    ansible.builtin.debug:
    var: installer_result.stdout_lines

  * name: Show installer stderr
    ansible.builtin.debug:
    var: installer_result.stderr_lines

  * name: Check AgentETP service after installation
    ansible.windows.win_shell: |
    $service = Get-CimInstance Win32_Service -Filter "Name='{{ service_name }}'" -ErrorAction SilentlyContinue

    if ($service) {
    Write-Output "SERVICE_EXISTS=YES"
    Write-Output "STATE=$($service.State)"
    Write-Output "STARTMODE=$($service.StartMode)"
    Write-Output "PATH=$($service.PathName)"
    }
    else {
    Write-Output "SERVICE_EXISTS=NO"
    }
    register: final_service
    changed_when: false

  * name: Show final service state
    ansible.builtin.debug:
    var: final_service.stdout_lines

  * name: Final message
    ansible.builtin.debug:
    msg:
    - "AgentETP installation diagnostic completed."
    - "The service was intentionally NOT started automatically."
    - "Installer was NOT deleted."
    - "Check the output above for ExitCode, MSI events and created files."
