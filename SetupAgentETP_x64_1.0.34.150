---
- name: Update 1C Agent KIP to 1.0.34.150
  hosts: windows
  gather_facts: no

  vars:
    target_version: "1.0.34.150"
    installer_path: "C:\\Windows\\Temp\\SetupAgentETP_x64_1.0.34.150.exe"
    install_log: "C:\\Windows\\Temp\\AgentETP_install.log"
    service_name: "1C_AgentETP_x86-64"

  tasks:

    # ---------------------------------------------------------
    # Определяем текущую версию AgentETP
    # ---------------------------------------------------------

    - name: Get installed AgentETP version
      ansible.windows.win_shell: |
        $service = Get-CimInstance Win32_Service -Filter "Name='{{ service_name }}'"

        if (-not $service) {
            Write-Output "SERVICE_NOT_FOUND"
            exit 0
        }

        $path = $service.PathName

        if ($path -match '"([^"]+AgentETP\.exe)"') {
            $exe = $matches[1]
        }
        elseif ($path -match '([A-Za-z]:\\.*AgentETP\.exe)') {
            $exe = $matches[1]
        }
        else {
            Write-Output "EXE_NOT_FOUND"
            exit 0
        }

        if (Test-Path $exe) {
            $version = (Get-Item $exe).VersionInfo.ProductVersion

            Write-Output "EXE=$exe"
            Write-Output "VERSION=$version"
        }
        else {
            Write-Output "EXE_NOT_FOUND"
        }
      register: agent_version
      changed_when: false

    - name: Show current AgentETP version
      ansible.builtin.debug:
        var: agent_version.stdout_lines

    # ---------------------------------------------------------
    # Скачиваем установщик
    # ---------------------------------------------------------

    - name: Download AgentETP 1.0.34.150
      ansible.windows.win_get_url:
        url: "https://github.com/vanyabolshoi/ansible/raw/refs/heads/main/SetupAgentETP_x64_1.0.34.150.exe"
        dest: "{{ installer_path }}"
        force: yes

    # ---------------------------------------------------------
    # Проверяем установщик
    # ---------------------------------------------------------

    - name: Check installer
      ansible.windows.win_stat:
        path: "{{ installer_path }}"
      register: installer_file

    - name: Verify installer exists
      ansible.builtin.assert:
        that:
          - installer_file.stat.exists
          - installer_file.stat.size > 100000
        fail_msg: "Установщик AgentETP не найден или имеет подозрительно маленький размер."
        success_msg: "Установщик AgentETP найден."

    # ---------------------------------------------------------
    # Останавливаем службу
    # ---------------------------------------------------------

    - name: Stop 1C Agent KIP service
      ansible.windows.win_service:
        name: "{{ service_name }}"
        state: stopped
      register: service_stop

    # ---------------------------------------------------------
    # Устанавливаем AgentETP
    # ---------------------------------------------------------

    - name: Install AgentETP 1.0.34.150
      ansible.windows.win_shell: |
        $ErrorActionPreference = "Stop"

        $installer = "{{ installer_path }}"
        $log = "{{ install_log }}"

        Write-Output "Starting AgentETP installer..."
        Write-Output "Installer: $installer"
        Write-Output "Log: $log"

        if (-not (Test-Path $installer)) {
            throw "Installer not found: $installer"
        }

        # Удаляем старый лог
        if (Test-Path $log) {
            Remove-Item $log -Force -ErrorAction SilentlyContinue
        }

        # Запускаем установщик
        $process = Start-Process `
            -FilePath $installer `
            -ArgumentList "/S" `
            -WorkingDirectory (Split-Path $installer) `
            -PassThru

        Write-Output "Installer PID: $($process.Id)"

        # Ждём максимум 10 минут
        $timeout = 600
        $elapsed = 0

        while (-not $process.HasExited) {

            Start-Sleep -Seconds 5
            $elapsed += 5

            Write-Output "Installer running... $elapsed seconds"

            if ($elapsed -ge $timeout) {

                Write-Output "INSTALLER TIMEOUT"

                try {
                    Stop-Process -Id $process.Id -Force -ErrorAction SilentlyContinue
                }
                catch {
                }

                throw "AgentETP installer exceeded 10 minute timeout."
            }
        }

        $exitCode = $process.ExitCode

        Write-Output "Installer finished."
        Write-Output "Exit code: $exitCode"

        if (Test-Path $log) {
            Write-Output "Installation log:"
            Get-Content $log -Tail 100 -ErrorAction SilentlyContinue
        }

        if ($exitCode -ne 0) {
            throw "AgentETP installer failed with exit code $exitCode"
        }
      register: installer_result

    - name: Show installer result
      ansible.builtin.debug:
        msg:
          - "Installer stdout:"
          - "{{ installer_result.stdout }}"
          - "Installer stderr:"
          - "{{ installer_result.stderr }}"

    # ---------------------------------------------------------
    # Ждём завершения фоновых процессов установщика
    # ---------------------------------------------------------

    - name: Wait for AgentETP installation
      ansible.windows.win_shell: |
        Start-Sleep -Seconds 10
      changed_when: false

    # ---------------------------------------------------------
    # Запускаем службу
    # ---------------------------------------------------------

    - name: Start 1C Agent KIP service
      ansible.windows.win_service:
        name: "{{ service_name }}"
        state: started
        start_mode: auto

    # ---------------------------------------------------------
    # Проверяем установленную версию
    # ---------------------------------------------------------

    - name: Check AgentETP version after update
      ansible.windows.win_shell: |
        $service = Get-CimInstance Win32_Service -Filter "Name='{{ service_name }}'"

        if (-not $service) {
            Write-Output "SERVICE_NOT_FOUND"
            exit 1
        }

        Write-Output "Service path:"
        Write-Output $service.PathName

        if ($service.PathName -match '"([^"]+AgentETP\.exe)"') {
            $exe = $matches[1]
        }
        elseif ($service.PathName -match '([A-Za-z]:\\.*AgentETP\.exe)') {
            $exe = $matches[1]
        }
        else {
            Write-Output "EXE_NOT_FOUND"
            exit 1
        }

        Write-Output "AgentETP EXE: $exe"

        if (-not (Test-Path $exe)) {
            Write-Output "EXE_NOT_FOUND"
            exit 1
        }

        $version = (Get-Item $exe).VersionInfo.ProductVersion

        Write-Output "Installed version: $version"

        if ($version -eq "{{ target_version }}") {
            Write-Output "UPDATE_SUCCESS"
            exit 0
        }
        else {
            Write-Output "VERSION_MISMATCH"
            exit 2
        }
      register: version_check
      changed_when: false

    - name: Show final version
      ansible.builtin.debug:
        var: version_check.stdout_lines

    # ---------------------------------------------------------
    # Проверяем службу
    # ---------------------------------------------------------

    - name: Check AgentETP service
      ansible.windows.win_service:
        name: "{{ service_name }}"
      register: agent_service
      changed_when: false

    - name: Verify AgentETP service is running
      ansible.builtin.assert:
        that:
          - agent_service.state == "started"
        fail_msg: "1С:Агент КИП установлен, но служба не запущена!"
        success_msg: "1С:Агент КИП запущен."

    # ---------------------------------------------------------
    # Удаляем установщик
    # ---------------------------------------------------------

    - name: Remove installer
      ansible.windows.win_file:
        path: "{{ installer_path }}"
        state: absent
