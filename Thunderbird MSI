---
- name: Установить Thunderbird
  hosts: all
  gather_facts: false

  tasks:
    - name: Создать папку для загрузки
      ansible.windows.win_file:
        path: C:\Temp
        state: directory

    - name: Скачать Thunderbird MSI
      ansible.windows.win_get_url:
        url: "https://download.mozilla.org/?product=thunderbird-msi-latest-ssl&os=win64&lang=ru"
        dest: 'C:\Temp\Thunderbird.msi'
        force: true

    - name: Установить Thunderbird
      ansible.windows.win_package:
        path: 'C:\Temp\Thunderbird.msi'
        state: present
        arguments: "/qn ALLUSERS=1"

    - name: Удалить установщик
      ansible.windows.win_file:
        path: 'C:\Temp\Thunderbird.msi'
        state: absent
