---
- name: Get Windows version and IP
  hosts: windows
  gather_facts: no

  tasks:

    - name: Get Windows information
      ansible.windows.win_shell: |
        $os = Get-CimInstance Win32_OperatingSystem

        $ips = (
          Get-NetIPAddress -AddressFamily IPv4 |
          Where-Object {
            $_.IPAddress -notlike '127.*' -and
            $_.IPAddress -notlike '169.254.*'
          } |
          Select-Object -ExpandProperty IPAddress
        ) -join ', '

        [PSCustomObject]@{
          ComputerName = $env:COMPUTERNAME
          IP           = $ips
          Windows      = $os.Caption
          Version      = $os.Version
          Build        = $os.BuildNumber
          Architecture = $os.OSArchitecture
        } | ConvertTo-Json -Compress
      register: windows_info
      changed_when: false

    - name: Show Windows information
      ansible.builtin.debug:
        msg: |
          ╔══════════════════════════════════════════════════════════════╗
          ║                 WINDOWS INFORMATION                       ║
          ╠══════════════════════════════════════════════════════════════╣
          ║ Computer : {{ (windows_info.stdout | from_json).ComputerName }}
          ║ IP       : {{ (windows_info.stdout | from_json).IP }}
          ║ Windows  : {{ (windows_info.stdout | from_json).Windows }}
          ║ Version  : {{ (windows_info.stdout | from_json).Version }}
          ║ Build    : {{ (windows_info.stdout | from_json).Build }}
          ║ Arch     : {{ (windows_info.stdout | from_json).Architecture }}
          ╚══════════════════════════════════════════════════════════════╝
