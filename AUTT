---
- name: Collect Authenticator backups
  hosts: windows
  gather_facts: no

  tasks:

    - name: Check authenticator backup exists
      win_stat:
        path: C:\Temp\authenticator.json
      register: auth_file

    - name: Read authenticator backup
      win_shell: Get-Content C:\Temp\authenticator.json -Raw
      register: auth_data
      when: auth_file.stat.exists

    - name: Append to common file on Semaphore
      delegate_to: localhost
      become: false
      blockinfile:
        path: /opt/semaphore/authenticator_backup.txt
        create: yes
        marker: ""
        block: |

          ==================================================
          HOST: {{ inventory_hostname }}
          IP: {{ ansible_host }}
          DATE: {{ lookup('pipe','date "+%Y-%m-%d %H:%M:%S"') }}
          ==================================================

          {{ auth_data.stdout | default('NO BACKUP FILE FOUND') }}

      when: auth_file.stat.exists

    - name: Log missing backup
      delegate_to: localhost
      become: false
      blockinfile:
        path: /opt/semaphore/authenticator_backup.txt
        create: yes
        marker: ""
        block: |

          ==================================================
          HOST: {{ inventory_hostname }}
          IP: {{ ansible_host }}
          DATE: {{ lookup('pipe','date "+%Y-%m-%d %H:%M:%S"') }}
          STATUS: authenticator.json NOT FOUND
          ==================================================

      when: not auth_file.stat.exists
