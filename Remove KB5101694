---
- name: Remove KB5101694 and disable Windows Update
  hosts: windows
  gather_facts: false

  tasks:

    - name: Check if KB5101694 is installed
      ansible.windows.win_shell: |
        if (Get-HotFix -Id KB5101694 -ErrorAction SilentlyContinue) {
          Write-Output "INSTALLED"
        }
      register: kb_check
      changed_when: false

    - name: Uninstall KB5101694
      ansible.windows.win_shell: |
        Start-Process -FilePath "wusa.exe" -ArgumentList "/uninstall /kb:5101694 /quiet /norestart" -Wait
      when: "'INSTALLED' in kb_check.stdout"
      register: uninstall_result

    - name: Stop Windows Update service
      ansible.windows.win_service:
        name: wuauserv
        state: stopped

    - name: Disable Windows Update service
      ansible.windows.win_service:
        name: wuauserv
        start_mode: disabled

    - name: Disable Windows Update Medic Service
      ansible.windows.win_regedit:
        path: HKLM:\SYSTEM\CurrentControlSet\Services\WaaSMedicSvc
        name: Start
        data: 4
        type: dword

    - name: Disable Windows Update scheduled tasks
      ansible.windows.win_shell: |
        $tasks = Get-ScheduledTask | Where-Object {
          $_.TaskPath -like "\Microsoft\Windows\WindowsUpdate\*"
        }

        foreach ($task in $tasks) {
          Disable-ScheduledTask -TaskName $task.TaskName -TaskPath $task.TaskPath
        }
      ignore_errors: true

    - name: Disable Windows Update Orchestrator tasks
      ansible.windows.win_shell: |
        $tasks = Get-ScheduledTask | Where-Object {
          $_.TaskPath -like "\Microsoft\Windows\UpdateOrchestrator\*"
        }

        foreach ($task in $tasks) {
          Disable-ScheduledTask -TaskName $task.TaskName -TaskPath $task.TaskPath
        }
      ignore_errors: true

    - name: Reboot if KB was removed
      ansible.windows.win_reboot:
        reboot_timeout: 3600
      when: "'INSTALLED' in kb_check.stdout"
