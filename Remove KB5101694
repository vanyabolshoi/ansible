---
- name: Remove KB5101694 and disable Windows Update
  hosts: windows
  gather_facts: false

  tasks:

    - name: Check if KB5101694 is installed
      ansible.windows.win_shell: |
        Get-HotFix -Id KB5101694 -ErrorAction SilentlyContinue
      register: kb_check
      changed_when: false

    - name: Uninstall KB5101694
      ansible.windows.win_shell: |
        wusa.exe /uninstall /kb:5101694 /quiet /norestart
      when: kb_check.stdout != ""
      register: uninstall_result

    - name: Disable Windows Update service
      ansible.windows.win_service:
        name: wuauserv
        start_mode: disabled
        state: stopped

    - name: Disable Update Medic Service
      ansible.windows.win_shell: |
        Set-ItemProperty `
          -Path "HKLM:\SYSTEM\CurrentControlSet\Services\WaaSMedicSvc" `
          -Name Start `
          -Value 4
      changed_when: true

    - name: Disable scheduled Windows Update tasks
      ansible.windows.win_shell: |
        Get-ScheduledTask -TaskPath "\Microsoft\Windows\WindowsUpdate\" |
        Disable-ScheduledTask
      changed_when: true

    - name: Reboot if update was removed
      ansible.windows.win_reboot:
      when: kb_check.stdout != ""
