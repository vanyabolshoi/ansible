---
- name: Remove KB5101684 and enable RDP
  hosts: windows
  gather_facts: false

  tasks:

    - name: Check if KB5101684 is installed
      ansible.windows.win_shell: |
        if (Get-HotFix -Id KB5101684 -ErrorAction SilentlyContinue) {
          Write-Output "INSTALLED"
        }
      register: kb_check
      changed_when: false

    - name: Remove KB5101684
      ansible.windows.win_shell: |
        wusa.exe /uninstall /kb:5101684 /quiet /norestart
      when: "'INSTALLED' in kb_check.stdout"

    - name: Enable Remote Desktop
      ansible.windows.win_regedit:
        path: HKLM:\SYSTEM\CurrentControlSet\Control\Terminal Server
        name: fDenyTSConnections
        data: 0
        type: dword
      when: "'INSTALLED' in kb_check.stdout"

    - name: Enable RDP firewall rules
      ansible.windows.win_shell: |
        Enable-NetFirewallRule -DisplayGroup "Remote Desktop"
      when: "'INSTALLED' in kb_check.stdout"
      ignore_errors: true

    - name: Ensure Remote Desktop Service is running
      ansible.windows.win_service:
        name: TermService
        state: started
        start_mode: auto
      when: "'INSTALLED' in kb_check.stdout"
      ignore_errors: true

    - name: Reboot only if KB5101684 was installed
      ansible.windows.win_reboot:
        reboot_timeout: 7200
        post_reboot_delay: 60
      when: "'INSTALLED' in kb_check.stdout"
