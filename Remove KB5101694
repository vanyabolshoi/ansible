---
- name: Remove KB5101684 and disable Windows Update
  hosts: windows
  gather_facts: false

  tasks:

    - name: Check if KB5101684 is installed
      ansible.windows.win_shell: |
        if (Get-HotFix -Id KB5101684 -ErrorAction SilentlyContinue) {
          Write-Output "INSTALLED"
        }
      register: kb_check
      changed_when: false

    - name: Uninstall KB5101684
      ansible.windows.win_shell: |
        Start-Process -FilePath "wusa.exe" -ArgumentList "/uninstall /kb:5101684 /quiet /norestart" -Wait
      when: "'INSTALLED' in kb_check.stdout"

    - name: Stop Windows Update service
      ansible.windows.win_service:
        name: wuauserv
        state: stopped
      ignore_errors: true

    - name: Disable Windows Update service
      ansible.windows.win_service:
        name: wuauserv
        start_mode: disabled
      ignore_errors: true

    - name: Disable automatic updates via policy
      ansible.windows.win_regedit:
        path: HKLM:\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU
        name: NoAutoUpdate
        data: 1
        type: dword

    - name: Set AUOptions to notify only
      ansible.windows.win_regedit:
        path: HKLM:\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU
        name: AUOptions
        data: 2
        type: dword

    - name: Disable Windows Update Medic Service
      ansible.windows.win_shell: |
        reg add "HKLM\SYSTEM\CurrentControlSet\Services\WaaSMedicSvc" /v Start /t REG_DWORD /d 4 /f
      ignore_errors: true

    - name: Disable Update Orchestrator tasks
      ansible.windows.win_shell: |
        Get-ScheduledTask | Where-Object {
          $_.TaskPath -like "\Microsoft\Windows\UpdateOrchestrator\*"
        } | Disable-ScheduledTask
      ignore_errors: true

    - name: Disable Windows Update tasks
      ansible.windows.win_shell: |
        Get-ScheduledTask | Where-Object {
          $_.TaskPath -like "\Microsoft\Windows\WindowsUpdate\*"
        } | Disable-ScheduledTask
      ignore_errors: true

    - name: Reboot if KB was installed
      ansible.windows.win_reboot:
        reboot_timeout: 3600
      when: "'INSTALLED' in kb_check.stdout"
