---
- name: Remove KB5101684 and disable Windows Update
  hosts: windows
  gather_facts: false

  tasks:

    - name: Check if KB5101684 is installed
      ansible.windows.win_shell: |
        if (Get-HotFix -Id KB5101684 -ErrorAction SilentlyContinue) {
          Write-Output "INSTALLED"
        }
      register: kb_check
      changed_when: false

    - name: Uninstall KB5101684
      ansible.windows.win_shell: |
        wusa.exe /uninstall /kb:5101684 /quiet /norestart
      when: "'INSTALLED' in kb_check.stdout"

    - name: Stop Windows Update service
      ansible.windows.win_service:
        name: wuauserv
        state: stopped

    - name: Disable Windows Update service
      ansible.windows.win_service:
        name: wuauserv
        start_mode: disabled

    - name: Disable Update Orchestrator Service
      ansible.windows.win_service:
        name: UsoSvc
        state: stopped
        start_mode: disabled
      ignore_errors: true

    - name: Disable Delivery Optimization
      ansible.windows.win_service:
        name: DoSvc
        state: stopped
        start_mode: disabled
      ignore_errors: true

    - name: Disable Windows Update Medic Service
      ansible.windows.win_regedit:
        path: HKLM:\SYSTEM\CurrentControlSet\Services\WaaSMedicSvc
        name: Start
        data: 4
        type: dword

    - name: Disable Windows Update tasks
      ansible.windows.win_shell: |
        Get-ScheduledTask |
        Where-Object {
          $_.TaskPath -like "\Microsoft\Windows\WindowsUpdate\*" -or
          $_.TaskPath -like "\Microsoft\Windows\UpdateOrchestrator\*"
        } |
        Disable-ScheduledTask
      ignore_errors: true

    - name: Reboot if KB was installed
      ansible.windows.win_reboot:
        reboot_timeout: 3600
      when: "'INSTALLED' in kb_check.stdout"
